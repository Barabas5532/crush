CAPI=2:
# vim:syntax=yaml:

name: ::crush:0.0.1

filesets:
  rtl:
    files:
      - rtl/alu.v
      - rtl/cpu.v
      - rtl/inst_decode_registers.v
      - rtl/inst_immediate_decode.v
      - rtl/program_counter.v
      - rtl/registers.v
      - rtl/params.vh:
          is_include_file: true
    file_type: verilogSource

  sim_inst_immediate_decode:
    files:
     - sim/inst_immediate_decode_tb.v
    file_type: systemVerilogSource

  sim_memory:
    files:
     - sim/memory_tb.v
    file_type: systemVerilogSource

  sim_alu:
    files:
     - sim/alu_tb.v
    file_type: systemVerilogSource

  sim_load_store:
    files:
     - sim/load_store_tb.v
    file_type: systemVerilogSource

  sim_cpu:
    files:
     - sim/control.v
     - sim/cpu_tb.v
    file_type: systemVerilogSource

  sim_common:
    files:
      - sim/fatal_assert.vh:
          is_include_file: true
      # YOSYS_DATDIR must be defined in the calling environemnt. e.g.:
      # export YOSYS_DATDIR=$(yosys-config --datdir)
      - $YOSYS_DATDIR/ice40/cells_sim.v
    file_type: verilogSource

  verilator_waiver:
    files:
      - ../data/verilator_waiver.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
      - rtl
    tools:
      icestorm:
        nextpnr_options : [ "--up5k", "--package", "sg48" ]
        yosys_synth_options:
          - "-dsp"
      icarus:
        timescale: "1s/100ms"
        iverilog_options:
          - "-g2012"
          - "-gassertions"

  lint:
    default_tool : verilator
    filesets:
      - verilator_waiver
      - rtl
      - sim_inst_immediate_decode
      - sim_memory
      - sim_alu
      - sim_load_store
      - sim_cpu
      - sim_common
    tools:
      verilator:
        mode : lint-only
        verilator_options:
          - "-Wall -timing"
          # Disable default values in yosys's simulation modules.
          - "-DNO_ICE40_DEFAULT_ASSIGNMENTS"
    toplevel: crush

  sim_inst_immediate_decode:
    <<: *default
    filesets_append:
      - sim_common
      - sim_inst_immediate_decode
    toplevel: inst_immediate_decode_tb
    default_tool: icarus

  sim_memory:
    <<: *default
    filesets_append:
      - sim_common
      - sim_memory
    toplevel: memory_tb
    default_tool: icarus

  sim_alu:
    <<: *default
    filesets_append:
      - sim_common
      - sim_alu
    toplevel: alu_tb
    default_tool: icarus

  sim_load_store:
    <<: *default
    filesets_append:
      - sim_common
      - sim_load_store
    toplevel: load_store_tb
    default_tool: icarus

  sim_cpu:
    <<: *default
    filesets_append:
      - sim_common
      - sim_cpu
    toplevel: cpu_tb
    default_tool: icarus

