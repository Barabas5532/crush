CAPI=2:
# vim:syntax=yaml:

name: ::crush_support:0.0.1

filesets:
  sim_common:
    files:
      - sim/fatal_assert.vh:
          is_include_file: true
    file_type: verilogSource

targets:
  default: &default
    filesets:
      - sim_common
    tools:
      icarus:
        iverilog_options:
          - "-gassertions"
